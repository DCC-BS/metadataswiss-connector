# I14Y Partner API
I14Y_BASE_URL=https://api-a.i14y.admin.ch/api/partner/v1
I14Y_TOKEN_URL=https://identity.i14y.a.c.bfs.admin.ch/realms/bfs-sis-a/protocol/openid-connect/token
I14Y_IRI_BASE=https://iri.i14y.a.c.bfs.admin.ch/concept
I14Y_CLIENT_ID=
I14Y_CLIENT_SECRET=
I14Y_PUBLISHER_IDENTIFIER=CH_KT_BS
I14Y_USER_AGENT=metadataswiss-connector/0.1.0 (Statistisches Amt Basel-Stadt; contact: statistik@bs.ch)

# Dataspot source connection. Resolved by dlt via the SOURCES__DATASPOT__* prefix.
SOURCES__DATASPOT__BASE_URL=https://datenkatalog.bs.ch
SOURCES__DATASPOT__DATABASE_NAME=dev-i14y
SOURCES__DATASPOT__TENANT_ID=
SOURCES__DATASPOT__CLIENT_ID=
SOURCES__DATASPOT__CLIENT_SECRET=
SOURCES__DATASPOT__DATASPOT_ACCESS_KEY=
SOURCES__DATASPOT__EXPOSED_CLIENT_ID=

# Dataspot source — deployment-specific values (no fallback, all required)
# Role UUID of the "data owner" attribution in Dataspot (tenant-specific).
DATA_OWNER_ROLE_UUID=02222f05-5690-4cb8-8d90-c27ca57e98e9
# Staatskalender API for enriching organizational units with contact data.
STAATSKALENDER_BASE_URL=https://staatskalender.bs.ch/api
# Fixed contacts for responsiblePerson / responsibleDeputy on every code-list concept, dataset and dataservice.
RESPONSIBLE_PERSON_EMAIL=email@example.com
RESPONSIBLE_DEPUTY_EMAIL=email@example.com

# Dagster instance home. Must point to a folder that contains the dagster.yaml
# (in the repo root) — otherwise `dagster dev` runs with an ephemeral instance
# and ignores the concurrency pool limits (DuckDB write-lock conflicts).
# In the Docker setup this value is overridden by docker-compose.
DAGSTER_HOME=/home/user/foo/metadataswiss-connector/.dagster_home_dev

# Sync schedule (full_sync_schedule). STOPPED in the UI by default —
# must be enabled deliberately. Cron + timezone overridable here.
CONNECTOR_SYNC_CRON=0 3 * * *
CONNECTOR_SYNC_TIMEZONE=Europe/Zurich

# --- Docker deployment only ---
# Bind-mount host paths: the container reads/writes these host folders directly,
# i.e. the same state files + DuckDB as a local `dagster dev`.
# Relative = relative to the compose file (repo root). Defaults are enough for
# "Docker locally against the same environment".
HOST_STATE_DIR=./.data/state          # Folder with the *_ids.json state files
HOST_DUCKDB_DIR=./.data              # Folder that contains the DuckDB
DUCKDB_FILENAME=metadata.duckdb
# Postgres storage for the Dagster instance (defaults in docker-compose.yml).
# DAGSTER_PG_USERNAME=dagster
# DAGSTER_PG_PASSWORD=change-me
# DAGSTER_PG_DB=dagster

# Email alerts on Dagster run failures (optional — sensor skips silently when not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls  # starttls (Port 587) | ssl (Port 465)
SMTP_FROM=
# Comma-separated for multiple recipients
EMAIL_TO=
# Deep links in the "quality issues" email are built from SOURCES__DATASPOT__BASE_URL
# + SOURCES__DATASPOT__DATABASE_NAME (.../web/{db}/{datasets|enumerations}/{id}).
# No additional configuration needed.
