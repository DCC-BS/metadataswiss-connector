# I14Y Partner API
I14Y_BASE_URL=https://api-a.i14y.admin.ch/api/partner/v1
I14Y_TOKEN_URL=https://identity.i14y.a.c.bfs.admin.ch/realms/bfs-sis-a/protocol/openid-connect/token
I14Y_IRI_BASE=https://iri.i14y.a.c.bfs.admin.ch/concept
I14Y_CLIENT_ID=
I14Y_CLIENT_SECRET=
I14Y_PUBLISHER_IDENTIFIER=CH_KT_BS
I14Y_USER_AGENT=metadataswiss-connector/0.1.0 (Statistisches Amt Basel-Stadt; contact: statistik@bs.ch)

# Dataspot source connection. Von dlt aufgelöst über das SOURCES__DATASPOT__*
SOURCES__DATASPOT__BASE_URL=https://datenkatalog.bs.ch
SOURCES__DATASPOT__DATABASE_NAME=dev-i14y
SOURCES__DATASPOT__TENANT_ID=
SOURCES__DATASPOT__CLIENT_ID=
SOURCES__DATASPOT__CLIENT_SECRET=
SOURCES__DATASPOT__DATASPOT_ACCESS_KEY=
SOURCES__DATASPOT__EXPOSED_CLIENT_ID=

# Dataspot source — deployment-specific values (kein Fallback, alle erforderlich)
# Role-UUID der "data owner"-Attribution in Dataspot (tenant-spezifisch).
DATA_OWNER_ROLE_UUID=02222f05-5690-4cb8-8d90-c27ca57e98e9
# Staatskalender API zur Anreicherung von Organisationseinheiten mit Kontaktdaten.
STAATSKALENDER_BASE_URL=https://staatskalender.bs.ch/api
# Fixe Kontakte für responsiblePerson / responsibleDeputy auf jedem Code-List-Concept.
CONCEPT_RESPONSIBLE_PERSON_EMAIL=email@example.com
CONCEPT_RESPONSIBLE_DEPUTY_EMAIL=email@example.com

# Dagster instance home. Muss auf einen Ordner zeigen, der die dagster.yaml
# enthält (im Repo-Root) — sonst läuft `dagster dev` mit ephemerer Instance
# und ignoriert die Concurrency-Pool-Limits (DuckDB-Write-Lock-Konflikte).
# Im Docker-Setup wird dieser Wert von docker-compose überschrieben.
DAGSTER_HOME=~/.dagster_home

# Sync-Schedule (full_sync_schedule). Standardmässig in der UI GESTOPPT —
# muss bewusst aktiviert werden. Cron + Zeitzone hier überschreibbar.
CONNECTOR_SYNC_CRON=0 3 * * *
CONNECTOR_SYNC_TIMEZONE=Europe/Zurich

# --- Nur Docker-Deployment ---
# Bind-Mount-Host-Pfade: der Container liest/schreibt diese Host-Ordner direkt,
# d.h. dieselben State-Files + DuckDB wie ein lokales `dagster dev`.
# Relativ = relativ zum Compose-File (Repo-Root). Defaults reichen für
# "Docker lokal gegen dieselbe Umgebung".
HOST_STATE_DIR=./data/state          # Ordner mit den *_ids.json State-Files
HOST_DUCKDB_DIR=./data              # Ordner, der die DuckDB enthält
DUCKDB_FILENAME=metadata.duckdb
# Postgres-Storage für die Dagster-Instanz (Defaults in docker-compose.yml).
# DAGSTER_PG_USERNAME=dagster
# DAGSTER_PG_PASSWORD=change-me
# DAGSTER_PG_DB=dagster

# Email-Alerts bei Dagster Run Failures (optional — Sensor skipped silently wenn nicht gesetzt)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls  # starttls (Port 587) | ssl (Port 465)
SMTP_FROM=
# Kommagetrennt für mehrere Empfänger
EMAIL_TO=
# Deep-Links in der "Qualitätsprobleme"-Mail werden aus SOURCES__DATASPOT__BASE_URL
# + SOURCES__DATASPOT__DATABASE_NAME gebaut (.../web/{db}/{datasets|enumerations}/{id}).
# Keine zusätzliche Konfiguration nötig.
